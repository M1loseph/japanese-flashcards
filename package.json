{
  "name": "flashcards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "NODE_OPTIONS=\"--localstorage-file=${TMPDIR:-/tmp}/jflashcards-vitest-localstorage\" vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint-fix": "eslint . --fix",
    "format-check": "prettier --check '*.ts' 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "format": "prettier --write '*.ts' 'src/**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tabler/flags-react": "0.1.1",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "dayjs": "1.11.23",
    "dexie": "4.4.7",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.4",
    "react-router-dom": "7.18.4",
    "wanakana": "5.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "2.11.33",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
